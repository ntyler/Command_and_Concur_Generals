; Original RTS controls prototype. Open in Godot 4.7.2.
config_version=5

[application]
config/name="Fieldwork — RTS Controls"
run/main_scene="res://scenes/test_field.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[input]
camera_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319)]}
camera_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321)]}
camera_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
camera_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
camera_zoom_in={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":4)]}
camera_zoom_out={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":5)]}
select_units={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1)]}
command_move={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":2)]}
selection_modifier={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
cancel_selection={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
movement_debug={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194334)]}
unit_stop={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":88)]}

[layer_names]
3d_physics/layer_1="Terrain"
3d_physics/layer_2="Units"
3d_physics/layer_3="Obstacles"
3d_physics/layer_4="Weapon Blockers"

[rendering]
anti_aliasing/quality/msaa_3d=2
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.055,0.075,0.09,1)
